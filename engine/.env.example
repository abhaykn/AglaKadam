# Settings of the scoring engine (engine/), read from the environment when it scores the checks
# waiting on the server (`agla-engine score`). On GitHub Actions and Kaggle they are secrets of the
# repository or the notebook. Never commit real values.

# The Supabase project, and its secret key (Project Settings -> API Keys -> Secret keys).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# A Hugging Face token of an account that accepted the terms of
# ai4bharat/indic-conformer-600m-multilingual. Without it Hindi reading is transcribed with
# Whisper, and every such score is marked uncertain.
HF_TOKEN=
