# Copy this file to `.env.local` and adjust the values for your environment.
# Only variables prefixed with VITE_ are exposed to the browser; never place secrets here.

# Supabase project (Project Settings → API Keys). Use the publishable key, never a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Deployment stage: development | staging | production
VITE_APP_ENV=development

# Shows the way into the clearly labelled demonstration district (with the `DEMO_ENABLED` secret).
# Keep this `false` for any deployment used by real schools.
VITE_ENABLE_DEMO_WORKSPACE=false
