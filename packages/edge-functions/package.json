{
  "name": "@agla-kadam/edge-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Tests and checks for the Supabase Edge Functions in supabase/functions.",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0 && node scripts/deno.mjs lint --no-config ../../supabase/functions",
    "typecheck": "tsc --noEmit && node scripts/deno.mjs check --no-lock --no-config ../../supabase/functions/account-admin/index.ts ../../supabase/functions/account-password/index.ts ../../supabase/functions/family-sign-in/index.ts ../../supabase/functions/pulse-retention/index.ts ../../supabase/functions/notify/index.ts ../../supabase/functions/sahayak/index.ts ../../supabase/functions/demo/index.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "deno": "2.9.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
