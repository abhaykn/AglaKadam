# Secrets of the Edge Functions. On the hosted project they are set with
# `npx supabase secrets set NAME=value` (or `npm run ai:keys` and `npm run push:keys`, which ask for
# the values without echoing them). For a local `supabase functions serve`, copy this file to
# `supabase/functions/.env` and fill it in. Never commit real values.
#
# SUPABASE_URL and the project's own keys are provided by the platform; they are not set here.

# Sahayak (supabase/functions/sahayak) and Disha (supabase/functions/disha). Without GROQ_API_KEY
# Sahayak answers 503 `not_configured`; Disha needs at least one of the two keys.
GROQ_API_KEY=
# Optional. Disha (supabase/functions/disha) asks Claude first and Groq when Claude cannot answer;
# the rehearsal room and its debrief use Claude too. Without it everything uses Groq.
ANTHROPIC_API_KEY=
# Optional model overrides, for example when a service retires a model.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_TUTOR_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# CLAUDE_MODEL=claude-sonnet-5-5
# Claude requests the whole project may make in a day (each person may make at most 60).
# CLAUDE_DAILY_LIMIT=600

# Web Push (supabase/functions/notify). `npm run push:keys` creates and stores the key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach: `mailto:` followed by an email address you read.
VAPID_SUBJECT=

# Demonstration districts (supabase/functions/demo): `true` lets visitors open one.
DEMO_ENABLED=false
